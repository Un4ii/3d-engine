CompileFlags:
  Compiler: cl.exe
  Add:
    - -std=c++20
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wno-unused-parameter
    - -Wshadow
    - -Wconversion
    - -Wnull-dereference
    - -fno-exceptions
    - -Wno-c++98-compat
    - -D_HAS_EXCEPTIONS=0
    - -Wno-old-style-cast  
  CompilationDatabase: build

Index:
  Background: Build
  StandardLibrary: Yes

Diagnostics:
  UnusedIncludes: Strict

InlayHints:
  Designators: false